#!/usr/bin/env python3
"""Launcher: runs the package from this checkout, so a symlink to this file on
PATH is the whole installation (stdlib only, nothing to pip install)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from cairn.cli import main  # noqa: E402

sys.exit(main())
